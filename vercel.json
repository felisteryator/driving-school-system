{
    "version": 2,
    "builds": [{
        "src": "fullstackdjango/wsgi.py",
        "use": "@vercel/python",
        "config": {
            "maxLambdaSize": "15mb" , "runtime": "python3.13.7"
        }
    },
    {
        "src": "build_files.sh",
        "use": "@vercel/static-build",
        "config": {
            "distDir": "staticfiles_build"
        }
    }],
    "routes": [{
        "src": "/(.*)",
        "dest": "/static/$1"
    },
    {
        "src": "/(.*)",
        "dest": "fullstackdjango/wsgi.py"
    }]
}